# The public site reads a draft. It is not a static export.

# EDITOR_PASSWORD is the /admin password. ADMIN_PASSWORD is accepted as an alias.
EDITOR_PASSWORD=
# Signs the login cookie. Required together with the password.
SESSION_SECRET=
# When set, drafts, visit counts, and uploads go to Vercel Blob.
# Without it, the server writes .data/*.json and public/uploads/ on this machine.
BLOB_READ_WRITE_TOKEN=
